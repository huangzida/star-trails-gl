{
  "name": "@bg-effects/star-trails-gl",
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@10.25.0",
  "description": "Star Trails GL Effect - A high-performance star trails background effect built with OGL and Vue.",
  "author": "huangzida",
  "license": "MIT",
  "keywords": [
    "star-trails",
    "webgl",
    "ogl",
    "vue",
    "background-effect",
    "animation"
  ],
  "homepage": "https://github.com/huangzida/star-trails-gl#readme",
  "bugs": {
    "url": "https://github.com/huangzida/star-trails-gl/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/huangzida/star-trails-gl.git"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "engines": {
    "node": ">=20.17.0"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.umd.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "dev": "vite build --watch",
    "play": "vite --mode playground",
    "build": "vite build",
    "build:play": "vite build --mode playground",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint \"src/**/*.{ts,vue}\"",
    "format": "prettier --write \"**/*.{ts,vue,md,json}\"",
    "release": "plop --plopfile scripts/release.cjs"
  },
  "dependencies": {
    "@bg-effects/debug-ui": "workspace:*",
    "defu": "^6.1.4"
  },
  "devDependencies": {
    "@bg-effects/configs": "workspace:*",
    "@bg-effects/core": "workspace:*",
    "@bg-effects/shared": "workspace:*",
    "@vitejs/plugin-vue": "^5.0.0",
    "changelogen": "^0.6.2",
    "ogl": "^1.0.11",
    "plop": "^4.0.5",
    "typescript": "^5.7.3",
    "unocss": "^66.6.0",
    "vite": "^5.0.0",
    "vite-plugin-css-injected-by-js": "^3.5.2",
    "vite-plugin-dts": "^4.5.1",
    "vue": "^3.5.13",
    "vue-tsc": "^2.2.0"
  },
  "peerDependencies": {
    "ogl": "^1.0.0",
    "vue": "^3.3.0"
  }
}
